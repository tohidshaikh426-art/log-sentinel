# ==============================================================================
# Log Sentinel — Environment Configuration Template
# Copy relevant sections to frontend/.env.local or collector/.env.
# NEVER commit real secrets or .env files to Git.
# ==============================================================================

# --- Frontend (Vite / React) --------------------------------------------------
# Only public Supabase project URL and anon/publishable key belong here.
# NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend environment variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Or use Supabase's newer key name:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# --- Python Collector (Monitored Linux Machine) -------------------------------
# Secure Edge Function endpoints (never direct DB credentials)
LOG_SENTINEL_INGEST_URL=https://your-project-ref.supabase.co/functions/v1/ingest-events
LOG_SENTINEL_HEARTBEAT_URL=https://your-project-ref.supabase.co/functions/v1/collector-heartbeat

# Device identity & per-device collector secret (issued during device setup)
LOG_SENTINEL_DEVICE_ID=00000000-0000-0000-0000-000000000000
LOG_SENTINEL_DEVICE_NAME=ubuntu-prod-01
LOG_SENTINEL_COLLECTOR_TOKEN=replace-with-per-device-collector-token

# Log source settings
LOG_SENTINEL_SOURCE_TYPE=auth_log
LOG_SENTINEL_LOG_PATH=/var/log/auth.log
LOG_SENTINEL_POLL_INTERVAL_SECONDS=2
LOG_SENTINEL_BATCH_SIZE=25
LOG_SENTINEL_HEARTBEAT_INTERVAL_SECONDS=30
LOG_SENTINEL_STATE_DB_PATH=./data/collector_state.sqlite3
