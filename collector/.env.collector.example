# Log Sentinel Python Collector — Example Configuration
# Copy to `collector/.env` (never commit `.env` to Git).

LOG_SENTINEL_INGEST_URL=https://your-project-ref.supabase.co/functions/v1/ingest-events
LOG_SENTINEL_HEARTBEAT_URL=https://your-project-ref.supabase.co/functions/v1/collector-heartbeat

LOG_SENTINEL_DEVICE_ID=00000000-0000-0000-0000-000000000000
LOG_SENTINEL_DEVICE_NAME=ubuntu-prod-01
LOG_SENTINEL_COLLECTOR_TOKEN=replace-with-per-device-collector-token

LOG_SENTINEL_SOURCE_TYPE=auth_log
LOG_SENTINEL_LOG_PATH=/var/log/auth.log
LOG_SENTINEL_START_AT_END=true
LOG_SENTINEL_POLL_INTERVAL_SECONDS=2
LOG_SENTINEL_BATCH_SIZE=25
LOG_SENTINEL_HEARTBEAT_INTERVAL_SECONDS=30
LOG_SENTINEL_STATE_DB_PATH=./data/collector_state.sqlite3
LOG_SENTINEL_LOCAL_LOG_FILE=./data/collector.log
